        {
            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.760, 0.610, 0.410)
                float inputs:roughness = 0.35
                float inputs:metallic = 0.00
